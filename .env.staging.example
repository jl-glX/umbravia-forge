NODE_ENV=production
APP_ENV=staging
PORT=3001
HOST=127.0.0.1

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://umbravia:replace-me@127.0.0.1:5432/umbravia_forge_staging
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

CLIENT_ORIGIN=https://staging.example.com
WEBAUTHN_ORIGIN=https://staging.example.com
WEBAUTHN_RP_ID=staging.example.com

MAX_REQUEST_SIZE=32kb
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=10
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
SIGNUP_RATE_LIMIT_WINDOW_MINUTES=60
SIGNUP_RATE_LIMIT_MAX_REQUESTS=5
EMAIL_VERIFICATION_RATE_LIMIT_MAX_REQUESTS=3

VITE_TURNSTILE_SITE_KEY=replace-with-the-staging-public-site-key
TURNSTILE_SECRET_KEY=replace-with-the-staging-private-secret-key
EMAIL_VERIFICATION_ENABLED=true
MFA_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Umbravia Forge Staging <no-reply@staging.replace-me.example>"
EMAIL_QUEUE_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key
PRIVATE_CONTENT_ENCRYPTION_ENABLED=false
PRIVATE_CONTENT_ENCRYPTION_KEY=
SUPPORT_NOTIFICATION_EMAIL=
SUPPORT_ATTACHMENT_MAX_BYTES=5242880
SUPPORT_MUTATION_RATE_LIMIT_MAX_REQUESTS=30
EMAIL_PUBLIC_INBOUND_ENABLED=false
EMAIL_PUBLIC_INBOUND_PROVIDER=cloudflare
SUPPORT_EMAIL_INBOUND_ENABLED=false
SUPPORT_EMAIL_ADDRESS=support@staging.replace-me.example
SUPPORT_EMAIL_REPLY_TOKEN_KEY=replace-with-a-different-staging-32-byte-base64-key
SUPPORT_EMAIL_WEBHOOK_SECRET=replace-with-another-staging-32-byte-base64-key

# Use a distinct staging route and Worker instance for corporate UMF Support.
UMF_SUPPORT_EMAIL_INBOUND_ENABLED=false
UMF_SUPPORT_EMAIL_ADDRESS=corporate-support@staging.replace-me.example
UMF_SUPPORT_EMAIL_REPLY_TOKEN_KEY=replace-with-a-third-staging-32-byte-base64-key
UMF_SUPPORT_EMAIL_WEBHOOK_SECRET=replace-with-a-fourth-staging-32-byte-base64-key
UMF_SUPPORT_MAIL_ATTACHMENT_MAX_BYTES=5242880
UMF_SUPPORT_MAIL_ATTACHMENT_TOTAL_MAX_BYTES=10485760

SEED_DEMO_DATA=false
COMMERCIAL_TRIALS_ENABLED=false
ENVIRONMENT_DATA_ROOT=/var/lib/umbravia-forge-staging/environments
ENVIRONMENT_MANAGER_MUTATIONS_ENABLED=false

RESOURCE_RUNTIME_CHECK_INTERVAL_MS=300000
VITE_SHUTDOWN_TIMEOUT_MS=5000
ACCOUNT_LIFECYCLE_REVIEW_INTERVAL_MS=3600000

# Staging must use Stripe Test objects. Live mode is rejected by startup
# validation even though the optimized server runs with NODE_ENV=production.
STRIPE_BILLING_ENABLED=false
STRIPE_BILLING_MODE=test
STRIPE_RESTRICTED_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FORGE_MONTHLY=
STRIPE_PRICE_FORGE_ANNUAL=
STRIPE_PORTAL_CONFIGURATION_ID=
