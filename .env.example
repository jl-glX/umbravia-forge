NODE_ENV=development
APP_ENV=development
PORT=3001
HOST=127.0.0.1

# Database provider. SQLite is for local development, automated tests and
# self-contained commercial MVP demos. Normal deployments use PostgreSQL;
# production requires PostgreSQL and a secret DATABASE_URL.
DATABASE_PROVIDER=sqlite
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Comma-separated browser origins allowed to call the API.
# Required in production, including same-origin deployments.
CLIENT_ORIGIN=http://localhost:3000

# WebAuthn uses the trusted browser origin and relying-party domain. In a
# production deployment these must match the public HTTPS application URL.
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost

# Express request and rate limits.
MAX_REQUEST_SIZE=32kb
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=10
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
SIGNUP_RATE_LIMIT_WINDOW_MINUTES=60
SIGNUP_RATE_LIMIT_MAX_REQUESTS=5
EMAIL_VERIFICATION_RATE_LIMIT_MAX_REQUESTS=3

# Cloudflare Turnstile. Both values are mandatory in production. Development
# uses Cloudflare's official always-pass test keys when they are omitted.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# New accounts stay pending until the owner confirms the mailbox.
EMAIL_VERIFICATION_ENABLED=true

# Transactional email used by account verification. An external SMTP relay
# should use TLS (usually port 587 with SMTP_REQUIRE_TLS=true). A self-hosted
# local Postfix instance can use 127.0.0.1:25 without credentials or TLS on the
# loopback hop; Postfix remains responsible for its outbound TLS, queue and
# delivery. These values are required only when email verification is enabled.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Encrypts pending transactional-email payloads at rest with AES-256-GCM.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_QUEUE_ENCRYPTION_KEY=
MANAGER_CONNECTION_ENCRYPTION_KEY=
MANAGER_CONNECTION_ENCRYPTION_KEYRING=
MANAGER_CONNECTION_ENCRYPTION_ACTIVE_KEY_ID=
PRIVATE_CONTENT_ENCRYPTION_ENABLED=false
PRIVATE_CONTENT_ENCRYPTION_KEY=

# Forge Support. The inbox address is optional; when configured, new tickets
# and requester replies are delivered through the same encrypted queue.
SUPPORT_NOTIFICATION_EMAIL=
SUPPORT_ATTACHMENT_MAX_BYTES=5242880
SUPPORT_MUTATION_RATE_LIMIT_MAX_REQUESTS=30

# Public inbound support email is disabled by default. When enabled through
# Cloudflare Email Routing, keep both 32-byte base64 secrets outside Git.
EMAIL_PUBLIC_INBOUND_ENABLED=false
EMAIL_PUBLIC_INBOUND_PROVIDER=cloudflare
SUPPORT_EMAIL_INBOUND_ENABLED=false
SUPPORT_EMAIL_ADDRESS=
SUPPORT_EMAIL_REPLY_TOKEN_KEY=
SUPPORT_EMAIL_WEBHOOK_SECRET=

# Public support is routed externally while the internal ticket boards remain
# preserved but frozen. Enable the portal only after its HTTPS route works.
INTERNAL_SUPPORT_TICKETS_ENABLED=false
UMF_SUPPORT_OPERATIONAL_WORKSPACE_ENABLED=false
EXTERNAL_HELPDESK_EMAIL_ADDRESS=umbravia-forge-scrf@support.openhelpdesk.dev
EXTERNAL_HELPDESK_PORTAL_URL=https://support.umbraviaforge.com
EXTERNAL_HELPDESK_PORTAL_ENABLED=false
GENERAL_CONTACT_EMAIL_ADDRESS=umbraviaforge@gmail.com
LEGAL_RIGHTS_EMAIL_ADDRESS=umbraviaforge@gmail.com

# Corporate UMF Support is a separate application and inbox. It can reuse a
# separately deployed instance of the generic Email Worker, but never the
# facility-support secrets. Keep all real values outside Git.
UMF_SUPPORT_EMAIL_INBOUND_ENABLED=false
UMF_SUPPORT_EMAIL_ADDRESS=
UMF_SUPPORT_EMAIL_REPLY_TOKEN_KEY=
UMF_SUPPORT_EMAIL_WEBHOOK_SECRET=
UMF_SUPPORT_WINDOWS_ZIP_URL=
UMF_COMPANY_HEAD_BOOTSTRAP_EMAIL_SHA256=

# Development resource hygiene. Runtime checks are clamped between 30 seconds
# and 60 minutes; Vite shutdown waits between 1 and 30 seconds before invoking
# its defensive owned-resource cleanup.
RESOURCE_RUNTIME_CHECK_INTERVAL_MS=300000
VITE_SHUTDOWN_TIMEOUT_MS=5000

# Account inactivity review. The interval is clamped between one minute and
# 24 hours. The review can only schedule the reversible 30-day grace period;
# destructive account deletion remains disabled.
ACCOUNT_LIFECYCLE_REVIEW_INTERVAL_MS=3600000

# Stripe Billing for the centre-to-Umbravia Forge SaaS subscription. Keep it
# disabled until the matching Test objects and restricted key are configured.
STRIPE_BILLING_ENABLED=false
STRIPE_BILLING_MODE=test
STRIPE_RESTRICTED_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FORGE_MONTHLY=
STRIPE_PRICE_FORGE_ANNUAL=
STRIPE_PORTAL_CONFIGURATION_ID=

# Demo accounts are never seeded in production unless explicitly enabled.
# Development and test environments seed demo data automatically. Production
# rejects SEED_DEMO_DATA=true because the demonstration passwords are public.
SEED_DEMO_DATA=false

# The current commercial trial is a single-centre foundation. Keep it disabled
# in production until an isolated trial environment has been reviewed.
COMMERCIAL_TRIALS_ENABLED=false

# Isolated SQLite environments managed for commercial MVPs and customer
# sandboxes. Mutations default to enabled outside production and disabled in
# production. Migration planning never transfers data automatically.
ENVIRONMENT_DATA_ROOT=./data/environments
ENVIRONMENT_MANAGER_MUTATIONS_ENABLED=true

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Development creates a local ignored key under data/ when this is left blank.
MFA_ENCRYPTION_KEY=

# Optional official distribution links. Only HTTPS URLs are exposed by the API.
DOWNLOAD_WINDOWS_URL=
DOWNLOAD_ANDROID_URL=
DOWNLOAD_MACOS_URL=
DOWNLOAD_IOS_URL=
DOWNLOAD_ZIP_URL=
