{
  "name": "umbravia-forge",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma modular para la gestión integral de centros deportivos.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jl-glX/umbravia-forge.git"
  },
  "bugs": {
    "url": "https://github.com/jl-glX/umbravia-forge/issues"
  },
  "homepage": "https://github.com/jl-glX/umbravia-forge#readme",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.18.0 <12"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "platform:managers": "tsx scripts/platform-manager-admin.ts",
    "company:reset-support-identity": "tsx scripts/reset-umf-support-identity.ts",
    "build": "node scripts/run-project-scripts.mjs build:client build:server build:support-email-worker",
    "build:client": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "build:support-email-worker": "node scripts/build-support-email-worker.mjs",
    "start": "node scripts/start-production.mjs",
    "deploy:package": "node scripts/validate-deployment-build.mjs && node scripts/run-project-scripts.mjs build && node scripts/prepare-deployment-package.mjs && node scripts/audit-deployment-package.mjs",
    "package:windows-web-apps": "node scripts/prepare-windows-web-apps-package.mjs",
    "db:postgres:validate-config": "tsx scripts/validate-postgres-config.ts",
    "mail:dns:check": "tsx server/bin/check-mail-dns.ts",
    "mail:dkim:generate-replacement": "node scripts/generate-dkim-replacement.mjs",
    "security:crypto-material:prepare-replacement": "tsx scripts/generate-key-replacement-bundle.ts",
    "portability:check": "node scripts/check-portability.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "typecheck": "node scripts/run-project-scripts.mjs typecheck:client typecheck:server typecheck:support-email-worker",
    "typecheck:client": "tsc --project tsconfig.json --noEmit",
    "typecheck:server": "tsc --project tsconfig.server.json --noEmit",
    "typecheck:support-email-worker": "tsc --project tsconfig.worker.json --noEmit",
    "test": "node scripts/testing/run-vitest.mjs run",
    "test:watch": "node scripts/testing/run-vitest.mjs watch",
    "security:probe": "node scripts/security/local-black-box.mjs",
    "security:password-resilience": "node scripts/security/password-resilience.mjs",
    "audit:ci": "node scripts/audit-ci.mjs",
    "check": "node scripts/run-project-scripts.mjs portability:check format:check lint typecheck test build package:windows-web-apps",
    "ci:validate": "node scripts/run-project-scripts.mjs check audit:ci",
    "ci": "node scripts/run-ci.mjs",
    "CI": "node scripts/run-ci.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.3.0",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "argon2": "0.45.1",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "express-validator": "7.3.2",
    "helmet": "8.3.0",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "kysely": "0.29.5",
    "lucide-react": "1.31.0",
    "nodemailer": "9.0.5",
    "otpauth": "9.5.1",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-router-dom": "7.18.2",
    "stripe": "22.5.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260811.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.10.12",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.21.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "pgsql-ast-parser": "12.0.2",
    "postal-mime": "2.7.6",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.1": true,
    "better-sqlite3@13.0.3": true
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  }
}
