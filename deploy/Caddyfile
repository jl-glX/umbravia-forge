# UMBRAVIA_DOMAIN selects the public hostname; every protection below remains
# identical when the hostname changes.
{$UMBRAVIA_DOMAIN:www.umbraviaforge.com} {
	tls {
		protocols tls1.3
	}

	encode zstd gzip

	@automated_probes {
		path /.env* /.git* /.hg* /.svn* /.aws* /.ssh* /.npmrc /.yarnrc /.htaccess /.htpasswd /config.json /package.json /package-lock.json /pnpm-lock.yaml /yarn.lock /composer.json /docker-compose* /Dockerfile /Caddyfile /web.config /appsettings.json /id_rsa /id_ed25519 /wp-login.php /wp-admin* /wp-content* /xmlrpc.php /phpmyadmin* /adminer.php /server-status /vendor/phpunit* /cgi-bin* /actuator*
	}
	respond @automated_probes 404

	@dangerous_methods method CONNECT TRACE TRACK
	respond @dangerous_methods 405

	# Caddy 2.10 or newer. Express keeps stricter per-route limits as the
	# authoritative second layer (32 KiB normally and 768 KiB for images).
	request_body {
		max_size 1MB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		# El comprobador de preparacion sustituye esta ruta por un archivo
		# temporal para no crear el registro de produccion como root.
		output file {$UMBRAVIA_CADDY_LOG:/var/log/caddy/umbravia-forge-access.log} {
			roll_size 25MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	reverse_proxy 127.0.0.1:3001 {
		health_uri /api/health/live
		health_interval 30s
		health_timeout 5s
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}
