NODE_ENV=production
APP_ENV=production
PORT=3001
HOST=127.0.0.1

DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://umbravia:replace-me@127.0.0.1:5432/umbravia_forge
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Encrypted PostgreSQL backups. Only the public age recipient belongs on the
# production server. Keep the corresponding private identity offline.
UMBRAVIA_BACKUP_AGE_RECIPIENT=
UMBRAVIA_BACKUP_DIRECTORY=/var/backups/umbravia-forge/postgresql
UMBRAVIA_BACKUP_RETENTION_DAYS=30

# Optional storage-volume profiles. These declare an already-created and
# mounted VeraCrypt volume; the application never creates or stores its key.
UMBRAVIA_POSTGRES_STORAGE_PROFILE=filesystem
UMBRAVIA_POSTGRES_STORAGE_MOUNT=/var/lib/postgresql
UMBRAVIA_SQLITE_STORAGE_PROFILE=filesystem
UMBRAVIA_SQLITE_STORAGE_MOUNT=/var/lib/umbravia-forge/sqlite

CLIENT_ORIGIN=https://app.example.com
WEBAUTHN_ORIGIN=https://app.example.com
WEBAUTHN_RP_ID=app.example.com

MAX_REQUEST_SIZE=32kb
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=10
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
SIGNUP_RATE_LIMIT_WINDOW_MINUTES=60
SIGNUP_RATE_LIMIT_MAX_REQUESTS=5
EMAIL_VERIFICATION_RATE_LIMIT_MAX_REQUESTS=3

TURNSTILE_SECRET_KEY=replace-with-the-private-secret-key
MFA_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key

# New accounts remain pending until their mailbox is confirmed.
EMAIL_VERIFICATION_ENABLED=true

# Local Postfix foundation. Replace EMAIL_FROM with a verified address on the
# production domain. For an external relay, use its host, credentials and TLS.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Umbravia Forge <no-reply@replace-me.example>"
EMAIL_QUEUE_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key

# Clave exclusiva para sobres autenticados entre gestores. No reutilizar MFA,
# correo, contenido privado, DKIM ni copias. La rotación puede prepararse con el
# keyring y el identificador activo sin retirar todavía claves legibles.
MANAGER_CONNECTION_ENCRYPTION_KEY=
MANAGER_CONNECTION_ENCRYPTION_KEYRING=
MANAGER_CONNECTION_ENCRYPTION_ACTIVE_KEY_ID=

# AES-256-GCM para mensajes privados y adjuntos en reposo. Genere una
# clave nueva de 32 bytes y actívela solo después de guardar una copia segura.
PRIVATE_CONTENT_ENCRYPTION_ENABLED=false
PRIVATE_CONTENT_ENCRYPTION_KEY=
# Rotación opcional y compatible con PRIVATE_CONTENT_ENCRYPTION_KEY. No retire
# ninguna clave anterior hasta haber recifrado e inventariado todos los datos.
# Formato: clave-2026:base64url,clave-2027:base64url
PRIVATE_CONTENT_ENCRYPTION_KEYRING=
PRIVATE_CONTENT_ENCRYPTION_ACTIVE_KEY_ID=
EMAIL_PUBLIC_MAIL_HOST=mail.replace-me.example
EMAIL_DKIM_SELECTOR=forge
EMAIL_PUBLIC_DNS_CHECK=warn
# Keep false until Cloudflare routing, the Worker and authenticated ingestion
# have been validated. Postfix remains loopback-only for outbound delivery.
EMAIL_PUBLIC_INBOUND_ENABLED=false
EMAIL_PUBLIC_INBOUND_PROVIDER=cloudflare
SUPPORT_EMAIL_INBOUND_ENABLED=false
SUPPORT_EMAIL_ADDRESS=support@replace-me.example
# Generate two independent 32-byte base64 secrets. Never reuse queue or MFA keys.
SUPPORT_EMAIL_REPLY_TOKEN_KEY=replace-with-a-different-random-32-byte-base64-key
SUPPORT_EMAIL_WEBHOOK_SECRET=replace-with-a-different-random-32-byte-base64-key
# UMF Support is a separate corporate channel. Use a different public address
# and independent secrets when both inbound applications are enabled.
UMF_SUPPORT_EMAIL_INBOUND_ENABLED=false
UMF_SUPPORT_EMAIL_ADDRESS=corporate-support@replace-me.example
UMF_SUPPORT_EMAIL_REPLY_TOKEN_KEY=replace-with-a-third-random-32-byte-base64-key
UMF_SUPPORT_EMAIL_WEBHOOK_SECRET=replace-with-a-fourth-random-32-byte-base64-key
UMF_SUPPORT_MAIL_ATTACHMENT_MAX_BYTES=5242880
UMF_SUPPORT_MAIL_ATTACHMENT_TOTAL_MAX_BYTES=10485760
SUPPORT_NOTIFICATION_EMAIL=
SUPPORT_ATTACHMENT_MAX_BYTES=5242880
SUPPORT_MUTATION_RATE_LIMIT_MAX_REQUESTS=30

SEED_DEMO_DATA=false
COMMERCIAL_TRIALS_ENABLED=false
# SHA-256 hexadecimal del correo corporativo normalizado. Mantener vacío salvo
# durante la inicialización única de la primera jefatura y retirar después.
UMF_COMPANY_HEAD_BOOTSTRAP_EMAIL_SHA256=
ENVIRONMENT_DATA_ROOT=/var/lib/umbravia-forge/environments
ENVIRONMENT_MANAGER_MUTATIONS_ENABLED=false

RESOURCE_RUNTIME_CHECK_INTERVAL_MS=300000
VITE_SHUTDOWN_TIMEOUT_MS=5000
ACCOUNT_LIFECYCLE_REVIEW_INTERVAL_MS=3600000

# Stripe is the payment authority; Forge only keeps the minimal commercial
# state needed for entitlements. Keep false until Live is configured and the
# complete billing lifecycle has passed controlled human validation.
STRIPE_BILLING_ENABLED=false
STRIPE_BILLING_MODE=live
STRIPE_RESTRICTED_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FORGE_MONTHLY=
STRIPE_PRICE_FORGE_ANNUAL=
STRIPE_PORTAL_CONFIGURATION_ID=
